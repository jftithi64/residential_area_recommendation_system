# Copy this file to .env. Never commit .env.
# Admin login (same Log in page as everyone). The account is created when the site starts.
# Password: 8+ characters with letters and numbers; `admin123`, `change-me` and similar are refused.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-your-own-1
# FORM_CSV_URL=https://docs.google.com/spreadsheets/d/.../pub?output=csv

# Email OTP at sign-up (free with Gmail). Turn on 2-Step Verification, then make an App Password at
# https://myaccount.google.com/apppasswords  (use the 16-character password, not your Gmail password).
# Leave these empty to run in DEMO mode: the code is shown on the sign-up page instead of emailed.
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
